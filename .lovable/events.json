{
  "schema_version": 1,
  "events": {
    "project.expense_reviewed": {
      "event_schema_version": 1,
      "description": "Finance approved or rejected a submitted expense claim.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision",
          "category"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "TRAVEL",
              "FOOD",
              "ACCOMMODATION",
              "FUEL",
              "COMMUNICATION",
              "ENTERTAINMENT",
              "OFFICE",
              "OTHER"
            ]
          }
        }
      }
    },
    "project.expense_submitted": {
      "event_schema_version": 1,
      "description": "A staff member submitted an expense claim for Finance review.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "receipt_count"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "TRAVEL",
              "FOOD",
              "ACCOMMODATION",
              "FUEL",
              "COMMUNICATION",
              "ENTERTAINMENT",
              "OFFICE",
              "OTHER"
            ]
          },
          "receipt_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        }
      }
    },
    "project.offline_order_queued": {
      "event_schema_version": 1,
      "description": "A Sales Officer's order was saved on the device to sync later (no connection or the connection dropped).",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason",
          "line_count"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "offline",
              "dropped"
            ]
          },
          "line_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "project.offline_order_rejected": {
      "event_schema_version": 1,
      "description": "A queued offline order was refused by the server during sync (e.g. not enough stock) and needs the Sales Officer's attention.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempts"
        ],
        "properties": {
          "attempts": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "project.offline_order_synced": {
      "event_schema_version": 1,
      "description": "A queued offline order was accepted by the server during automatic or manual sync.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempts",
          "wait_minutes"
        ],
        "properties": {
          "attempts": {
            "type": "integer",
            "minimum": 1
          },
          "wait_minutes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "project.order_delivered": {
      "event_schema_version": 1,
      "description": "An order became fully delivered: the delivery just confirmed handed over every remaining unit.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line_count",
          "had_partial_deliveries"
        ],
        "properties": {
          "line_count": {
            "type": "integer",
            "minimum": 1
          },
          "had_partial_deliveries": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
