# Copy to .env and replace every value before `docker compose up`.
# Production startup refuses the placeholder JWT secret and bootstrap password.

POSTGRES_PASSWORD=replace-owner-password
APP_DB_PASSWORD=replace-app-password
REDIS_PASSWORD=replace-redis-password
JWT_SECRET=change-me-jwt-secret-must-be-replaced-now
FILE_TOKEN_SECRET=change-me-file-secret-must-be-replaced

HTTP_PORT=80
PUBLIC_APP_URL=http://localhost
CORS_ORIGINS=http://localhost

# First account becomes Super Admin. Use a real password.
BOOTSTRAP_ADMIN_EMAIL=admin@biory.local
BOOTSTRAP_ADMIN_PASSWORD=replace-this-password
BOOTSTRAP_ADMIN_NAME=Super Admin

ALLOW_SIGNUP=true

# Leave SMTP_HOST empty until you have a mail server. Reset links are not sent without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@biory.local
SMTP_TLS=true
